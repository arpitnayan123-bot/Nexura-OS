  patientCopay      Float              @default(0)
  cashless          Boolean            @default(false)
  submittedAt       DateTime?
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient           HospitalPatient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission         HospitalAdmission? @relation(fields: [admissionId], references: [id])

  @@index([patientId])
  @@index([admissionId])
  @@index([tpaCompany])
  @@index([preAuthStatus])
  @@index([hospitalId])
}

model BloodBankUnit {
  id             String    @id @default(cuid())
  hospitalId     String
  bloodGroup     String // A+|A-|B+|B-|AB+|AB-|O+|O-
  component      String    @default("whole_blood") // whole_blood|packed_rbc|platelets|ffp|cryoprecipitate
  unitsAvailable Int       @default(0)
  expiryDate     DateTime?
  updatedAt      DateTime  @default(now())
  hospital       Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([bloodGroup])
}

model OTSurgery {
  id                   String             @id @default(cuid())
  hospitalId           String
  otRoomNumber         String
  patientUhid          String
  patientId            String
  procedureName        String
  surgeonId            String?
  anesthetistId        String?
  scrubNurseId         String?
  admissionId          String?
  plannedStartTime     DateTime?
  estimatedDurationMin Int?
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  status               String             @default("planned") // planned|in_progress|completed|cancelled|postponed
  preOpChecklist       String? // JSON {consent,fasted,site_marked,allergies_verified,blood_arranged,equipment_checked}
  createdAt            DateTime           @default(now())
  hospital             Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient              HospitalPatient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
