/**
 * ============================================================
 * NEXURA CLINIC OS — simple clinic operating system
 * Designed for solo practitioners & small clinics.
 * ============================================================
 */

model Clinic {
  id             String              @id @default(cuid())
  name           String
  ownerName      String?
  phone          String?
  email          String?
  address        String?
  city           String?
  regNo          String?
  bookingSlug    String?             @unique // public booking URL slug
  createdAt      DateTime            @default(now())
  doctors        ClinicDoctor[]
  patients       ClinicPatient[]
  appointments   ClinicAppointment[]
  visits         ClinicVisit[]
  invoices       ClinicInvoice[]
  onlineBookings OnlineBooking[]
  telemedicineConsults TelemedicineConsult[]
}

model ClinicDoctor {
  id             String              @id @default(cuid())
  clinicId       String
  name           String
  specialization String?
  qualification  String?
  phone          String?
  feeConsult     Float               @default(500)
  shiftStart     String? // "09:00"
  shiftEnd       String? // "17:00"
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments   ClinicAppointment[]
  visits         ClinicVisit[]
  onlineBookings OnlineBooking[]

  @@index([clinicId])
}

model ClinicPatient {
  id             String              @id @default(cuid())
  clinicId       String
  mrn            String              @unique
  abhaId         String? // ABDM Ayushman Bharat Health Account ID
  abhaProfile    String? // JSON cached profile from ABDM registry
  name           String
  gender         String              @default("male")
  age            Int?
  dob            String?
  phone          String?
  address        String?
  bloodGroup     String?
  allergy        String?
  chronicDx      String?
  createdAt      DateTime            @default(now())
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments   ClinicAppointment[]
  visits         ClinicVisit[]
  invoices       ClinicInvoice[]
  onlineBookings OnlineBooking[]
  followUps      FollowUp[]

  @@index([clinicId])
  @@index([phone])
  @@index([name])
  @@index([abhaId])
}

model ClinicAppointment {
  id        String        @id @default(cuid())
  clinicId  String
  patientId String
  doctorId  String
  slot      DateTime
  tokenNo   Int
  reason    String?
  status    String        @default("booked") // booked | arrived | done | cancelled | no_show
  source    String        @default("walkin") // walkin | online | phone
  createdAt DateTime      @default(now())
  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    ClinicDoctor  @relation(fields: [doctorId], references: [id])
  visit     ClinicVisit?

  @@index([clinicId])
  @@index([doctorId])
  @@index([slot])
  @@index([status])
}

// Clinic telemedicine consults (NMC Telemedicine Guidelines 2020 compliant) —
// consumed by /api/clinic/telemedicine. Scalar patient reference: the client
// may carry a ClinicPatient id or a walk-in identifier.
model TelemedicineConsult {
  id              String    @id @default(cuid())
  clinicId        String
  patientId       String?
  patientType     String    @default("clinic") // clinic | walkin
  doctorName      String
  doctorRegNo     String // NMC/MCI registration — mandatory for teleconsults
  consultMode     String    @default("video") // video | audio | chat
  chiefComplaint  String?
  diagnosis       String?
  prescription    String?
  followUpDate    DateTime?
  patientConsent  Boolean   @default(true)
  consentText     String?
  status          String    @default("scheduled") // scheduled | in_progress | completed | cancelled
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([clinicId, startedAt])
}

model ClinicVisit {
  id             String             @id @default(cuid())
  clinicId       String
  patientId      String
  doctorId       String?
  appointmentId  String?            @unique
  chiefComplaint String?
  vitalsBP       String?
  vitalsPulse    Int?
  vitalsTemp     Float?
  vitalsSpo2     Int?
  vitalsRBS      Int? // random blood sugar (nurse-recorded)
  weight         Float? // kg
  diagnosis      String?
  advice         String?
  followUp       String?
  status         String             @default("open") // open | closed
  createdAt      DateTime           @default(now())
  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        ClinicPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         ClinicDoctor?      @relation(fields: [doctorId], references: [id])
  appointment    ClinicAppointment? @relation(fields: [appointmentId], references: [id])
  meds           ClinicRx[]
  invoices       ClinicInvoice[]

  @@index([clinicId])
  @@index([patientId])
  @@index([createdAt])
}

model ClinicRx {
  id       String      @id @default(cuid())
  visitId  String
  medicine String
  dosage   String? // 1-0-1, BD
  duration String? // 5 days
  notes    String?
  visit    ClinicVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model ClinicInvoice {
  id          String        @id @default(cuid())
  clinicId    String
  patientId   String
  visitId     String?
  invoiceNo   String        @unique
  description String
  amount      Float
  discount    Float         @default(0)
  total       Float
  payMode     String        @default("cash")
  status      String        @default("unpaid") // unpaid | paid
  createdAt   DateTime      @default(now())
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit       ClinicVisit?  @relation(fields: [visitId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

/**
 * ============================================================
 * Gofrugal-style compliance extensions (Round 10)
 * ============================================================
 */

// Supplier payment (against purchase dues)
model SupplierPayment {
  id         String    @id @default(cuid())
  supplierId String
  purchaseId String?
  amount     Float
  payMode    String    @default("cash") // cash | upi | bank | cheque
  refNo      String? // cheque / utr
  notes      String?
  createdAt  DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([supplierId])
  @@index([createdAt])
}

// Customer credit account + payments
model CustomerAccount {
  id          String   @id @default(cuid())
  customerId  String   @unique
  creditLimit Float    @default(0)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  saleId     String?
  amount     Float
  payMode    String   @default("cash")
  refNo      String?
  notes      String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

// Schedule H / H1 register entry (drug inspector audit)
model ScheduleHEntry {
  id                String       @id @default(cuid())
  branchId          String
  serialNo          Int // running serial for the register
  saleId            String?
  saleItemId        String?
  saleDate          DateTime
  // patient
  patientName       String
  patientAddress    String?
  patientPhone      String?
  // doctor
  doctorName        String
  doctorRegNo       String
  prescriptionDate  String
  prescriptionImage String? // url/dataURL
  // medicine
  medicineName      String
  batchNo           String?
  qtyStrips         Int          @default(0)
  qtyLoose          Int          @default(0)
  schedule          String // H | H1
  createdAt         DateTime     @default(now())
  branch            PharmaBranch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([saleDate])
  @@index([serialNo])
}

// Near-expiry return (to supplier) + credit note
model NearExpiryReturn {
  id         String                 @id @default(cuid())
  branchId   String
  returnNo   String                 @unique // RET-2026-0001
  supplierId String
  supplier   Supplier               @relation(fields: [supplierId], references: [id])
  reason     String                 @default("Near expiry")
  status     String                 @default("initiated") // initiated | dispatched | credited
  cgst       Float                  @default(0)
  sgst       Float                  @default(0)
  total      Float                  @default(0)
  createdAt  DateTime               @default(now())
  branch     PharmaBranch           @relation(fields: [branchId], references: [id])
  items      NearExpiryReturnItem[]

  @@index([branchId])
  @@index([supplierId])
}

model NearExpiryReturnItem {
  id           String           @id @default(cuid())
  returnId     String
  productId    String
  batchId      String
  batchNo      String
  medicineName String
  expDate      String
  qtyStrips    Int
  mrp          Float
  cgstRate     Float            @default(0)
  sgstRate     Float            @default(0)
  lineTotal    Float            @default(0)
  return_      NearExpiryReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// Day closing summary (Z-report)
model DayClosing {
  id             String       @id @default(cuid())
  branchId       String
  closingDate    String // YYYY-MM-DD
  cashSales      Float        @default(0)
  upiSales       Float        @default(0)
  cardSales      Float        @default(0)
  creditSales    Float        @default(0)
  totalSales     Float        @default(0)
  cgstCollected  Float        @default(0)
  sgstCollected  Float        @default(0)
  totalGst       Float        @default(0)
  totalPurchases Float        @default(0)
  totalDiscount  Float        @default(0)
  netProfit      Float        @default(0)
  invoiceCount   Int          @default(0)
  closedBy       String?
  closedAt       DateTime     @default(now())
  branch         PharmaBranch @relation(fields: [branchId], references: [id])

  @@unique([branchId, closingDate])
  @@index([branchId])
}

/**
 * ============================================================
 * HealthPlix-style clinic extensions (Round 12)
 * Drug DB, online booking, follow-up automation
 * ============================================================
 */

// Indian drug database (for HealthPlix-style Rx autocomplete)
model IndianDrug {
  id        String   @id @default(cuid())
  brandName String // Crocin, Dolo, Augmentin
  saltName  String // Paracetamol, Amoxicillin
  strength  String? // 500mg, 650mg, 625mg
  form      String   @default("tablet") // tablet | syrup | capsule | injection | cream
  schedule  String? // H | H1 | OTC | Rx
  category  String? // analgesic | antibiotic | antacid | antidiabetic…
  company   String? // GSK, Cipla, Sun Pharma
  createdAt DateTime @default(now())

  @@index([brandName])
  @@index([saltName])
  @@index([category])
}

// Public online booking (from sharable URL)
model OnlineBooking {
  id                     String         @id @default(cuid())
  clinicId               String
  doctorId               String?
  patientName            String
  phone                  String
  slot                   DateTime
  status                 String         @default("booked") // booked | converted | cancelled
  convertedPatientId     String?
  convertedAppointmentId String?
  createdAt              DateTime       @default(now())
  clinic                 Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor                 ClinicDoctor?  @relation(fields: [doctorId], references: [id])
  patient                ClinicPatient? @relation(fields: [convertedPatientId], references: [id])

  @@index([clinicId])
  @@index([slot])
  @@index([status])
}

// Follow-up automation
model FollowUp {
  id             String        @id @default(cuid())
  clinicId       String
  patientId      String
  visitId        String?
  doctorId       String?
  followUpDate   DateTime
  reminderSent   Boolean       @default(false)
  rescheduleSent Boolean       @default(false)
  status         String        @default("pending") // pending | reminded | done | missed | rescheduled
  createdAt      DateTime      @default(now())
  patient        ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([followUpDate])
  @@index([status])
}

/**
 * ============================================================
 * NEXURA CONNECT — unified doctor-patient communication layer
 * Chat / Voice / Video modes with WhatsApp follow-up trigger.
 * Auto-creates connections from:
 * - Clinic consult save (source="clinic")
 * - Hospital IPD admission (source="hospital")
 * - KYH symptom triage (source="know_your_health")
 * ============================================================
 */

model ConnectConnection {
  id              String           @id @default(cuid())
  doctorId        String
  doctorName      String
  doctorSpecialty String?
  doctorPhone     String?
  patientId       String
  patientName     String
  patientPhone    String?
  patientAge      Int?
  patientGender   String?
  source          String           @default("clinic")
  sourceRefId     String?
  lastConsultDate DateTime?
  whatsappSent    Boolean          @default(false)
  whatsappSentAt  DateTime?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        ConnectMessage[]
  calls           ConnectCall[]
  queueEntries    ConnectQueue[]

  @@index([doctorId])
  @@index([patientId])
  @@index([source])
  @@index([active])
}

model ConnectMessage {
  id             String            @id @default(cuid())
  connectionId   String
  fromRole       String            @default("patient")
  fromName       String?
  text           String
  attachmentType String?
  attachmentUrl  String?
  read           Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  connection     ConnectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([createdAt])
  @@index([read])
}

model ConnectCall {
  id                 String            @id @default(cuid())
  connectionId       String
  type               String            @default("video")
  status             String            @default("initiated")
  initiatedBy        String            @default("patient")
  startedAt          DateTime          @default(now())
  answeredAt         DateTime?
  endedAt            DateTime?
  durationSec        Int?
  prescriptionJson   String?
  prescriptionSynced Boolean           @default(false)
  pharmacySyncId     String?
  callSummary        String?
  createdAt          DateTime          @default(now())
  connection         ConnectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([status])
}

model ConnectQueue {
  id                 String            @id @default(cuid())
  connectionId       String
  requestedMode      String            @default("chat")
  reason             String?
  status             String            @default("waiting")
  joinedAt           DateTime          @default(now())
  pickedUpAt         DateTime?
  pickedUpByDoctorId String?
  connection         ConnectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedMode])
}

