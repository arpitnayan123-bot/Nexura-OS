}

// ===== Patient Portal Models (Round 22) =====

model PortalUser {
  id                  String    @id @default(cuid())
  phone               String    @unique
  email               String?
  passwordHash        String?
  fullName            String
  dob                 String?
  gender              String?
  bloodGroup          String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  abhaId              String?
  profilePhoto        String?
  hospitalPatientUhid String?
  clinicPatientMrn    String?
  pharmacyCustomerId  String?
  familyHeadId        String?
  relationToHead      String?
  isOnboarded         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  lastLoginAt         DateTime?

  familyHead    PortalUser?    @relation("FamilyRelation", fields: [familyHeadId], references: [id])
  familyMembers PortalUser[]   @relation("FamilyRelation")
  bloodBookings BloodBooking[]

  @@index([phone])
