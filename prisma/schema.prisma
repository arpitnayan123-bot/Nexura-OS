model BloodBooking {
  id                 String    @id @default(cuid())
  userId             String
  bookingRef         String    @unique
  testPanelName      String
  testPanelCode      String
  testsIncluded      String
  price              Int
  scheduledDate      DateTime
  timeSlot           String
  address            String
  city               String
  pincode            String
  phlebotomistId     String?
  phlebotomistName   String?
  phlebotomistPhone  String?
