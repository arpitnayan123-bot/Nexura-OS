/**
 * ============================================================
 * NEXURA PREDICTIVE — HEALTH FORESIGHT ENGINE
 * Deterministic, explainable disease-risk signal engine for
 * Indian users. One table: every run stores its full input
 * + generated report so trends and history survive reloads.
 * No diagnosis claims — signal levels within screening scope.
 * ============================================================
 */

model ForesightRun {
  id          String   @id @default(cuid())
  subjectKey  String
  score       Int
  band        String
  triageLevel String   @default("STANDARD")
  topDomainId String
  inputJson   String
  reportJson  String
  engineVer   String
  createdAt   DateTime @default(now())

  @@index([subjectKey, createdAt])
}

/**
 * ============================================================
 * NEXURA DIY — consumer wellness roadmap module
 * 13 models: goals → plans (versioned) → milestones → tasks,
 * completions/progress, conflicts, granular consent, safety
 * events, plan changes, source-bound knowledge, AI audit,
 * idempotent generations. All identity = PortalUser.
 * ============================================================
 */

model DiyGoal {
  id                     String     @id @default(cuid())
  userId                 String
  user                   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId                String
  clientKey              String
  rawGoalText            String
  normalizedText         String
  category               String
  status                 String     @default("DRAFTED")
  timeframeDays          Int?
  requestedTimeframeDays Int?
  confidence             Float      @default(0.5)
  needsClarify           Boolean    @default(false)
  clarifyQuestion        String?
  priority               Int        @default(2)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  diyPlans               DiyPlan[]

  @@unique([userId, batchId, clientKey])
  @@index([userId, status])
  @@index([userId, category])
}

model DiyPlan {
  id               String    @id @default(cuid())
  goalId           String
  goal             DiyGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId           String
  version          Int       @default(1)
  status           String    @default("ACTIVE")
  roadmap          String
  sourcePack       String
  sourceKeys       String
  aiEnriched       Boolean   @default(false)
  contentValidated Boolean   @default(false)
  burdenScore      Float     @default(0)
  createdAt        DateTime  @default(now())
  retiredAt        DateTime?

  milestones   DiyMilestone[]
  tasks        DiyTask[]
  changes      DiyPlanChange[]
  portalUser   PortalUser?     @relation(fields: [portalUserId], references: [id])
  portalUserId String?

  @@index([userId, status])
  @@index([goalId, version])
}

model DiyMilestone {
  id        String  @id @default(cuid())
  planId    String
  plan      DiyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  targetDay Int
  sort      Int     @default(0)

  @@index([planId, targetDay])
}

model DiyTask {
  id          String   @id @default(cuid())
  planId      String
  plan        DiyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  milestoneId String?
  title       String
  detail      String?
  cadence     String   @default("DAILY")
  estMinutes  Int      @default(10)
  dayOffset   Int      @default(0)
  category    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  completions DiyTaskCompletion[]

  @@index([planId, active])
  @@index([category])
}

model DiyTaskCompletion {
  id           String      @id @default(cuid())
  taskId       String
  task         DiyTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  date         String
  status       String      @default("DONE")
  note         String?
  createdAt    DateTime    @default(now())
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId String?

  @@unique([taskId, userId, date])
  @@index([userId, date])
}

model DiyProgressLog {
  id             String      @id @default(cuid())
  userId         String
  date           String
  completedTasks Int         @default(0)
  skippedTasks   Int         @default(0)
  symptoms       String?
  mood           Int?
  energy         Int?
  sleep          Int?
  userNotes      String?
  createdAt      DateTime    @default(now())
  portalUser     PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId   String?

  @@unique([userId, date])
}

model DiyGoalConflict {
  id           String      @id @default(cuid())
  userId       String
  goalAId      String
  goalBId      String
  rule         String
  explanation  String
  resolution   String      @default("TRIMMED")
  createdAt    DateTime    @default(now())
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId String?

  @@index([userId])
}

model DiyConsent {
  id            String      @id @default(cuid())
  userId        String
  consentType   String
  purpose       String
  scope         String
  policyVersion String
  source        String
  grantedAt     DateTime    @default(now())
  withdrawnAt   DateTime?
  portalUser    PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId  String?

  @@index([userId, consentType])
}

model DiySafetyEvent {
  id             String      @id @default(cuid())
  userId         String?
  kind           String
  severity       String
  matchedPattern String
  sourceSnippet  String
  action         String
  createdAt      DateTime    @default(now())
  portalUser     PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId   String?

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model DiyPlanChange {
  id        String   @id @default(cuid())
  planId    String
  plan      DiyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromVer   Int
  toVer     Int
  reason    String
  summary   String
  createdAt DateTime @default(now())

  @@index([planId])
}

model DiyKnowledgeSource {
  id            String   @id @default(cuid())
  key           String   @unique
  title         String
  role          String
  license       String
  reviewStatus  String   @default("INTERNAL_REVIEW")
  url           String?
  prohibitedUse String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model DiyAiAudit {
  id           String      @id @default(cuid())
  userId       String?
  capability   String
  model        String
  latencyMs    Int
  requestId    String
  inputHash    String
  createdAt    DateTime    @default(now())
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId String?

  @@index([userId, createdAt])
}

model DiyGeneration {
  id             String      @id @default(cuid())
  userId         String
  idempotencyKey String      @unique
  status         String      @default("COMPLETED")
  planIds        String
  createdAt      DateTime    @default(now())
  portalUser     PortalUser? @relation(fields: [portalUserId], references: [id])
  portalUserId   String?

  @@index([userId, createdAt])
}

// ============================================================
// NEXURA OS — BACKEND CORE (backend-core-1)
// ============================================================

// Durable background job queue. Single-node safe (SQLite WAL or
// Postgres row locks) — claim is a guarded conditional update, so
// concurrent workers can never double-run a job.
model NxJob {
  id          String    @id @default(cuid())
  type        String
  dedupeKey   String    @unique
  payload     String    @default("{}")
  status      String    @default("pending") // pending | running | done | failed | dead
  runAt       DateTime  @default(now())
  maxAttempts Int       @default(3)
  attempts    Int       @default(0)
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

// Verified family invites — a portal head can no longer attach an
// existing onboarded PortalUser by phone alone; the invite must be
// accepted with a one-time token before any linkage happens.
model PortalFamilyInvite {
  id         String    @id @default(cuid())
  headId     String
  phone      String
  fullName   String
  relation   String
  tokenHash  String    @unique // sha256(one-time token); plaintext never stored
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([headId])
}
