// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Nexura OS — signups & appointment requests
model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  type      String   @default("early_access") // early_access | appointment
  specialty String?
  slot      String?
  reason    String?
  date      String? // ISO date string when type=appointment
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type])
}

/**
 * ============================================================
 * NEXURA PHARMACIA — AI-driven Pharmacy Management
 * Schema designed for multi-batch, salt-based, GST-compliant
 * retail pharmacy operations. SQLite-compatible (Postgres-ready).
 * ============================================================
 */

// Multi-branch company (pharmacy chain owner)
model PharmaCompany {
  id          String         @id @default(cuid())
  name        String
  gstin       String? // GST Identification Number
  email       String?
  phone       String?
  drugLicense String? // 20B/21B license
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  branches    PharmaBranch[]
  staff       PharmaStaff[]
}

model PharmaBranch {
  id                String             @id @default(cuid())
  companyId         String
  name              String
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstin             String?
  createdAt         DateTime           @default(now())
  company           PharmaCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff             PharmaStaff[]
  products          ProductBatch[]
  sales             Sale[]
  purchases         Purchase[]
  scheduleHEntries  ScheduleHEntry[]
  nearExpiryReturns NearExpiryReturn[]
  dayClosings       DayClosing[]

  @@index([companyId])
}

// Staff with roles (owner / manager / pharmacist / cashier)
model PharmaStaff {
  id        String        @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  email     String        @unique
  phone     String?
  role      String        @default("pharmacist") // owner | manager | pharmacist | cashier
  pinHash   String? // quick-login PIN hash
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  company   PharmaCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    PharmaBranch? @relation(fields: [branchId], references: [id])
  sales     Sale[]

  @@index([companyId])
  @@index([branchId])
}

// Customer (walk-in or registered, for GST billing)
model Customer {
  id        String            @id @default(cuid())
  name      String            @default("Walk-in")
  phone     String?
  email     String?
  gstin     String? // optional B2B GSTIN
  address   String?
  dob       String?
  createdAt DateTime          @default(now())
  sales     Sale[]
  account   CustomerAccount?
  payments  CustomerPayment[]

  @@index([phone])
  @@index([gstin])
}

// Supplier / distributor
model Supplier {
  id        String             @id @default(cuid())
  name      String
  phone     String?
  email     String?
  gstin     String?
  dlNumber  String? // drug license
  address   String?
  createdAt DateTime           @default(now())
  purchases Purchase[]
  payments  SupplierPayment[]
  returns   NearExpiryReturn[]

  @@index([name])
}

// Master product (medicine) — salt composition drives generic alternatives
model Product {
  id              String         @id @default(cuid())
  name            String
  genericName     String? // Paracetamol, Azithromycin…
  brand           String?
  category        String         @default("general") // tablet | syrup | capsule | ointment | injection | device
  hsn             String? // HSN code for GST
  schedule        String? // H / H1 / Rx / OTC
  salts           String? // comma-joined salt composition "Paracetamol 650mg"
  packaging       String? // "10x10 tablets" / "strip of 10"
  stripsPerBox    Int            @default(10)
  tabletsPerStrip Int            @default(10)
  cgstRate        Float          @default(6.0) // %
  sgstRate        Float          @default(6.0)
  reorderLevel    Int            @default(20) // units
  createdAt       DateTime       @default(now())
  batches         ProductBatch[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]

  @@index([name])
  @@index([genericName])
  @@index([hsn])
}

// Product batch — strict mfg/expiry, multi-batch per product
model ProductBatch {
  id           String       @id @default(cuid())
  productId    String
  branchId     String
  batchNo      String // B2, AX1021…
  barcode      String?
  mfgDate      String // ISO "2024-03"
  expDate      String // ISO "2026-03"
  mrp          Float // max retail price per strip/unit
  purchaseRate Float        @default(0)
  stockStrips  Int          @default(0)
  stockLoose   Int          @default(0) // loose tablets
  createdAt    DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch       PharmaBranch @relation(fields: [branchId], references: [id])
  saleItems    SaleItem[]

  @@index([productId])
  @@index([branchId])
  @@index([batchNo])
  @@index([barcode])
  @@index([expDate])
  @@unique([branchId, productId, batchNo])
}

// Sale (invoice)
model Sale {
  id          String       @id @default(cuid())
  invoiceNo   String       @unique // INV-2026-0001
  branchId    String
  staffId     String?
  customerId  String?
  subtotal    Float        @default(0)
  discountPct Float        @default(0)
  discount    Float        @default(0)
  cgst        Float        @default(0)
  sgst        Float        @default(0)
  roundOff    Float        @default(0)
  total       Float        @default(0)
  payMode     String       @default("cash") // cash | upi | card | credit
  status      String       @default("billed") // draft | billed | cancelled | returned
  createdAt   DateTime     @default(now())
  branch      PharmaBranch @relation(fields: [branchId], references: [id])
  staff       PharmaStaff? @relation(fields: [staffId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  items       SaleItem[]

  @@index([branchId])
  @@index([createdAt])
  @@index([invoiceNo])
  @@index([customerId])
  @@index([staffId])
}

model SaleItem {
  id          String       @id @default(cuid())
  saleId      String
  productId   String
  batchId     String
  qtyStrips   Int          @default(0)
  qtyLoose    Int          @default(0)
  mrpPerStrip Float
  discount    Float        @default(0)
  cgstRate    Float        @default(0)
  sgstRate    Float        @default(0)
  lineTotal   Float        @default(0)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  batch       ProductBatch @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

// Purchase order from supplier
model Purchase {
  id                String            @id @default(cuid())
  poNo              String            @unique
  supplierInvoiceNo String? // supplier's own invoice number
  branchId          String
  supplierId        String
  status            String            @default("draft") // draft | ordered | received | cancelled
  total             Float             @default(0)
  paidAmount        Float             @default(0)
  createdAt         DateTime          @default(now())
  branch            PharmaBranch      @relation(fields: [branchId], references: [id])
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  items             PurchaseItem[]
  payments          SupplierPayment[]

  @@index([branchId])
  @@index([supplierId])
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  productId    String
  batchNo      String
  mfgDate      String
  expDate      String
  mrp          Float
  purchaseRate Float
  qtyStrips    Int
  lineTotal    Float
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

/**
 * ============================================================
 * NEXURA HOSPITAL OS — The most advanced hospital OS for India
 * Built 2026 — Epic architecture + Oracle AI-first + WhatsApp + ABHA
 * ICMR/NFHS-5 Indian clinical intelligence, frugal 4G infrastructure
 * ============================================================
 */

model Hospital {
  id                      String                       @id @default(cuid())
  name                    String
  nabhAccredited          Boolean                      @default(false)
  gstin                   String?
  address                 String?
  district                String?
  state                   String?
  pincode                 String?
  contact                 String?
  subscriptionTier        String                       @default("standard") // basic | standard | premium
  createdAt               DateTime                     @default(now())
  doctors                 HospitalDoctor[]
  staff                   HospitalStaff[]
  wards                   HospitalWard[]
  beds                    HospitalBed[]
  patients                HospitalPatient[]
  appointments            HospitalAppointment[]
  admissions              HospitalAdmission[]
  bloodBank               BloodBankUnit[]
  otSurgeries             OTSurgery[]
  insuranceClaims         InsuranceClaim[]
  bills                   HospitalBill[]
  tourismInquiries        TourismInquiry[]
  tourismProcedures       TourismProcedure[]
  tourismSetting          TourismSetting?
  tourismCoordinators     TourismCoordinator[]
  tourismTestimonials     TourismTestimonial[]
  nxStaffUsers            NxStaffUser[]
  nxTasks                 NxTask[]
  nxIncidents             NxIncident[]
  nxAuditEvents           NxAuditEvent[]
  nxOrderEvents           NxOrderEvent[]
  nxEquipment             NxEquipment[]
  nxSupplies              NxSupplyItem[]
  nxMessages              NxMessage[]
  nxRules                 NxAutomationRule[]
  nxRuns                  NxWorkflowRun[]
  nxAIInteractions        NxAIInteraction[]
  organization            NxOrganization?              @relation(fields: [organizationId], references: [id])
  organizationId          String?
  nxDepartments           NxDepartment[]
  nxNotifications         NxNotification[]
  nxConsents              NxConsent[]
  nxChannels              NxChannel[]
  nxMedAdmins             NxMedicationAdministration[]
  nxImagingReports        NxImagingReport[]
  nxCharges               NxCharge[]
  nxPayments              NxPayment[]
  nxVendors               NxVendor[]
  nxPurchaseOrders        NxPurchaseOrder[]
  nxStockTxns             NxStockTxn[]
  nxShiftAssignments      NxShiftAssignment[]
  nxWaitlist              NxAppointmentWaitlist[]
  nxAppointmentEvents     NxAppointmentEvent[]
  nxWebhooks              NxWebhookDelivery[]
  nxWebhookEndpoints      NxWebhookEndpoint[]
  nxIntegrationEvents     NxIntegrationEvent[]
  nxFiles                 NxFileObject[]
  nxBreakGlassEvents      NxBreakGlassEvent[]
  // v5 — Chief Future Architect layer (tenancy + governance + flagship)
  tenant                  NxTenant?                    @relation(fields: [tenantId], references: [id])
  tenantId                String?
  nxAbacPolicies          NxAbacPolicy[]
  nxEscalationPolicies    NxEscalationPolicy[]
  nxEscalationEvents      NxEscalationEvent[]
  nxPathwayDefs           NxPathwayDef[]
  nxPathwayRuns           NxPathwayRun[]
  nxTimestampBlocks       NxTimestampBlock[]
  nxVerifiableCredentials NxVerifiableCredential[]
  nxInsuranceContracts    NxInsuranceContract[]
  nxWearableDevices       NxWearableDevice[]
  nxGenomicProfiles       NxGenomicProfile[]
  nxTeleConsults          NxTeleConsult[]
  nxAiThresholds          NxAiThreshold[]
  nxAiFeedbacks           NxAiFeedback[]
  nxDicomStudies          NxDicomStudy[]
  nxDocVersions           NxDocVersion[]
  nxJourneyAnnotations    NxJourneyAnnotation[]
  nxEventLogs             NxEventLog[]

  @@index([tenantId])
}

model HospitalPatient {
  id                        String                       @id @default(cuid())
  hospitalId                String
  uhid                      String                       @unique // auto-generated UHID
  abhaId                    String? // ABHA Ayushman Bharat ID
  abhaProfile               String? // JSON cached profile
  fullName                  String
  dob                       String? // ISO date
  age                       Int?
  gender                    String                       @default("male")
  bloodGroup                String?
  address                   String?
  district                  String?
  state                     String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  primaryLanguage           String                       @default("English") // Hindi|English|Tamil|Telugu|Marathi|Bengali|Kannada|Gujarati|Punjabi|Odia
  insuranceProvider         String?
  insurancePolicyNo         String?
  pmjayBeneficiary          Boolean                      @default(false)
  phone                     String?
  allergy                   String?
  chronicConditions         String?
  createdAt                 DateTime                     @default(now())
  hospital                  Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments              HospitalAppointment[]
  admissions                HospitalAdmission[]
  vitals                    HospitalVital[]
  clinicalNotes             ClinicalNote[]
  orders                    HospitalOrder[]
  prescriptions             HospitalPrescription[]
  bills                     HospitalBill[]
  insuranceClaims           InsuranceClaim[]
  otSurgeries               OTSurgery[]
  consents                  NxConsent[]
  medicationAdministrations NxMedicationAdministration[]
  files                     NxFileObject[]

  @@index([hospitalId])
  @@index([uhid])
  @@index([abhaId])
  @@index([phone])
}

model HospitalDoctor {
  id              String                 @id @default(cuid())
  hospitalId      String
  name            String
  regNo           String? // MCI/SMC registration
  specialty       String // Cardiologist|General Physician|Pediatrician|etc
  department      String?
  consultationFee Float                  @default(500)
  availableDays   String? // JSON array
  availableHours  String? // JSON {start,end}
  languagesSpoken String? // JSON array
  photoUrl        String?
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  hospital        Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments    HospitalAppointment[]
  admissions      HospitalAdmission[]
  clinicalNotes   ClinicalNote[]
  orders          HospitalOrder[]
  prescriptions   HospitalPrescription[]
  otSurgeries     OTSurgery[]            @relation("OTSurgeon")
  otAnesthetist   OTSurgery[]            @relation("OTAnesthetist")

  @@index([hospitalId])
  @@index([specialty])
}

model HospitalStaff {
  id             String          @id @default(cuid())
  hospitalId     String
  name           String
  role           String          @default("nurse") // admin|doctor|nurse|receptionist|lab|pharmacist|ot_tech|housekeeping
  department     String?
  shift          String? // morning|evening|night
  employeeId     String?
  phone          String?
  joinDate       DateTime?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  vitalsRecorded HospitalVital[]
  labResults     LabResult[]

  @@index([hospitalId])
  @@index([role])
}

model HospitalWard {
  id          String              @id @default(cuid())
  hospitalId  String
  name        String // ward name
  wardType    String              @default("general") // general|icu|hdu|maternity|pediatric|surgical|orthopedic|cardiac
  totalBeds   Int                 @default(10)
  floorNumber Int?
  createdAt   DateTime            @default(now())
  hospital    Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  beds        HospitalBed[]
  admissions  HospitalAdmission[]

  @@index([hospitalId])
}

model HospitalBed {
  id                 String              @id @default(cuid())
  hospitalId         String
  wardId             String
  bedNumber          String
  bedType            String              @default("general") // general|icu|hdu|isolation|maternity|pediatric|surgical
  status             String              @default("available") // available|reserved|occupied|cleaning_required|cleaning_in_progress|out_of_service|isolation|maintenance|cleaning (legacy)
  currentPatientUhid String?
  lastCleanedAt      DateTime?
  reservedForName    String?
  isolationReason    String?
  maintenanceNote    String?
  createdAt          DateTime            @default(now())
  hospital           Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward               HospitalWard        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions         HospitalAdmission[]

  @@unique([wardId, bedNumber])
  @@index([hospitalId])
  @@index([status])
}

// Double-booking guard: a PARTIAL unique index on ("doctorId","date") WHERE
// status NOT IN ('cancelled','no_show') enforces one active appointment per
// doctor + exact timeslot timestamp. Prisma cannot express partial indexes,
// so it is created as raw SQL in migration integrity_indexes_batch_identity
// (with a deterministic dedupe that cancels newer duplicates first).
model HospitalAppointment {
  id                String                 @id @default(cuid())
  hospitalId        String
  patientUhid       String
  patientId         String
  doctorId          String
  date              DateTime
  timeSlot          String
  tokenNumber       Int                    @default(1)
  appointmentType   String                 @default("opd") // opd|teleconsult|followup
  status            String                 @default("scheduled") // scheduled|waiting|in_consultation|completed|no_show|cancelled
  room              String?
  timezone          String                 @default("Asia/Kolkata")
  notes             String?
  checkedInAt       DateTime?
  reminderSentAt    DateTime?
  rescheduledFromId String?
  chiefComplaint    String?
  createdAt         DateTime               @default(now())
  hospital          Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient           HospitalPatient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor            HospitalDoctor         @relation(fields: [doctorId], references: [id])
  vitals            HospitalVital[]
  clinicalNotes     ClinicalNote[]
  orders            HospitalOrder[]
  prescriptions     HospitalPrescription[]
  bills             HospitalBill[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model HospitalAdmission {
  id                    String                 @id @default(cuid())
  hospitalId            String
  patientUhid           String
  patientId             String
  admittingDoctorId     String?
  wardId                String?
  bedId                 String?
  admissionDate         DateTime               @default(now())
  admissionDiagnosis    String?
  admissionType         String                 @default("emergency") // emergency|elective
  expectedDischargeDate DateTime?
  actualDischargeDate   DateTime?
  dischargeStatus       String? // active|discharged|transferred|expired
  dischargeSummary      String?
  createdAt             DateTime               @default(now())
  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient               HospitalPatient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admittingDoctor       HospitalDoctor?        @relation(fields: [admittingDoctorId], references: [id])
  ward                  HospitalWard?          @relation(fields: [wardId], references: [id])
  bed                   HospitalBed?           @relation(fields: [bedId], references: [id])
  vitals                HospitalVital[]
  clinicalNotes         ClinicalNote[]
  orders                HospitalOrder[]
  prescriptions         HospitalPrescription[]
  bills                 HospitalBill[]
  insuranceClaims       InsuranceClaim[]
  otSurgeries           OTSurgery[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([bedId])
  @@index([admittingDoctorId])
  @@index([wardId])
  @@index([dischargeStatus])
}

model HospitalVital {
  id                String               @id @default(cuid())
  hospitalId        String
  patientUhid       String
  patientId         String
  admissionId       String?
  appointmentId     String?
  recordedByStaffId String?
  recordedAt        DateTime             @default(now())
  bpSystolic        Int?
  bpDiastolic       Int?
  pulseRate         Int?
  temperatureC      Float?
  respiratoryRate   Int?
  spo2              Int?
  bloodGlucose      Int?
  weightKg          Float?
  heightCm          Float?
  glasgowComaScale  Int? // GCS for ICU
  news2Score        Int? // auto-calculated
  createdAt         DateTime             @default(now())
  patient           HospitalPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission         HospitalAdmission?   @relation(fields: [admissionId], references: [id])
  appointment       HospitalAppointment? @relation(fields: [appointmentId], references: [id])
  recordedBy        HospitalStaff?       @relation(fields: [recordedByStaffId], references: [id])

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([recordedByStaffId])
  @@index([recordedAt])
  @@index([hospitalId])
}

model ClinicalNote {
  id                  String               @id @default(cuid())
  hospitalId          String
  patientUhid         String
  patientId           String
  doctorId            String?
  appointmentId       String?
  admissionId         String?
  noteType            String               @default("soap") // soap|progress|discharge|procedure|referral
  status              String               @default("draft") // draft|signed|amended
  signedAt            DateTime?
  signedByName        String?
  signedByRole        String?
  locked              Boolean              @default(false) // signed notes are immutable
  addendumToNoteId    String? // addendum chain
  currentVersion      Int                  @default(1)
  restricted          Boolean              @default(false) // behavioral health / sensitive
  subjective          String?
  objective           String?
  assessment          String?
  plan                String?
  fullText            String?
  dictationTranscript String?
  aiStructured        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  patient             HospitalPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor              HospitalDoctor?      @relation(fields: [doctorId], references: [id])
  appointment         HospitalAppointment? @relation(fields: [appointmentId], references: [id])
  admission           HospitalAdmission?   @relation(fields: [admissionId], references: [id])
  versions            NxNoteVersion[]

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([noteType])
  @@index([status])
  @@index([hospitalId])
}

model HospitalOrder {
  id               String               @id @default(cuid())
  hospitalId       String
  patientUhid      String
  patientId        String
  orderingDoctorId String?
  admissionId      String?
  appointmentId    String?
  orderType        String               @default("lab") // lab|medication|imaging|procedure|referral|diet
  orderDetails     String // JSON
  priority         String               @default("routine") // routine|urgent|stat
  status           String               @default("ordered") // ordered|acknowledged|in_progress|completed|cancelled
  createdAt        DateTime             @default(now())
  patient          HospitalPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           HospitalDoctor?      @relation(fields: [orderingDoctorId], references: [id])
  admission        HospitalAdmission?   @relation(fields: [admissionId], references: [id])
  appointment      HospitalAppointment? @relation(fields: [appointmentId], references: [id])
  labResults       LabResult[]
  imagingReports   NxImagingReport[]
  nxOrderEvents    NxOrderEvent[]

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([orderingDoctorId])
  @@index([orderType])
  @@index([status])
  @@index([priority])
  @@index([hospitalId])
}

model LabResult {
  id                 String         @id @default(cuid())
  orderId            String
  testName           String
  resultValue        String?
  unit               String?
  refRangeMin        Float?
  refRangeMax        Float?
  abnormalFlag       String         @default("normal") // normal|low|high|critical
  resultText         String? // for qualitative tests
  reportedByStaffId  String?
  reportedAt         DateTime?
  verificationStatus String         @default("pending") // pending|verified|rejected
  verifiedByStaffId  String?
  verifiedAt         DateTime?
  criticalNotifiedAt DateTime?
  collectedAt        DateTime?
  createdAt          DateTime       @default(now())
  order              HospitalOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy         HospitalStaff? @relation(fields: [reportedByStaffId], references: [id])

  @@index([orderId])
  @@index([abnormalFlag])
  @@index([verificationStatus])
  @@index([reportedByStaffId])
}

model HospitalMedicine {
  id               String   @id @default(cuid())
  medicineName     String
  genericName      String?
  saltComposition  String?
  company          String?
  packType         String?
  gstRate          Float    @default(12)
  nppaControlled   Boolean  @default(false)
  nppaCeilingPrice Float?
  cdscoBanned      Boolean  @default(false)
  schedule         String   @default("otc") // otc|schedule_h|schedule_h1|ndps
  stockQuantity    Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([medicineName])
  @@index([genericName])
}

model HospitalPrescription {
  id                  String               @id @default(cuid())
  hospitalId          String
  patientUhid         String
  patientId           String
  prescribingDoctorId String?
  consultationId      String? // appointment or admission
  items               String // JSON array of {medicineId, dose, frequency, duration, route, instructions}
  createdAt           DateTime             @default(now())
  patient             HospitalPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor              HospitalDoctor?      @relation(fields: [prescribingDoctorId], references: [id])
  // Two FKs share one column (consultationId may point at an appointment OR an
  // admission). SQLite tolerated the auto-generated constraint-name collision;
  // Postgres requires unique names — explicit `map` keeps both installable.
  appointment         HospitalAppointment? @relation(fields: [consultationId], references: [id], map: "HospitalPrescription_consultation_appointment_fkey")
  admission           HospitalAdmission?   @relation(fields: [consultationId], references: [id], map: "HospitalPrescription_consultation_admission_fkey")

  @@index([patientId])
  @@index([consultationId])
  @@index([prescribingDoctorId])
  @@index([hospitalId])
}

model HospitalBill {
  id               String               @id @default(cuid())
  hospitalId       String
  patientUhid      String
  patientId        String
  admissionId      String?
  appointmentId    String?
  billDate         DateTime             @default(now())
  itemizedCharges  String // JSON array
  subtotal         Float                @default(0)
  discount         Float                @default(0)
  cgst             Float                @default(0)
  sgst             Float                @default(0)
  totalPayable     Float                @default(0)
  paymentMode      String               @default("cash") // cash|upi|card|insurance|credit
  insuranceClaimId String?
  paymentStatus    String               @default("unpaid") // unpaid|paid|partial|refunded
  createdAt        DateTime             @default(now())
  hospital         Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient          HospitalPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment      HospitalAppointment? @relation(fields: [appointmentId], references: [id])
  admission        HospitalAdmission?   @relation(fields: [admissionId], references: [id])

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([billDate])
  @@index([paymentStatus])
  @@index([hospitalId])
}

model InsuranceClaim {
  id                String             @id @default(cuid())
  hospitalId        String
  patientUhid       String
  patientId         String
  admissionId       String?
  tpaCompany        String // Star Health|Medi-Assist|Vidal|MD India|Heritage|United India|New India|Oriental|Bajaj Allianz|ICICI Lombard|Niva Bupa
  policyNumber      String?
  icd10Primary      String?
  icd10Secondary    String? // JSON array
  plannedProcedures String? // JSON array
