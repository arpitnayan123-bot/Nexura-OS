# ============================================================
# NEXURA HOSPITAL OS — environment template
# Copy to .env and fill in real values.
# Required-vs-optional is marked per variable. The production
# boot gate (src/lib/env.ts assertProductionEnv, wired from
# src/instrumentation.ts) refuses to boot production when a
# REQUIRED variable is missing or malformed. Dev stays
# forgiving and only warns.
# ============================================================

# ---------- REQUIRED (self-hosted production boot gate) ----------

# Postgres connection string. On SELF-HOSTED production this is a hard
# requirement (the boot gate refuses to boot without it).
# Accepted schemes: postgres://, postgresql://, prisma+postgres:// (pgbouncer).
#
# ZERO-CONFIG SERVERLESS DEMO (vercel-deploy-3): on Vercel with NO env vars
# configured, omit this entirely — the deployment boots on the committed
# seeded demo database (db/demo.db, SQLite flavor client generated at build
# time by scripts/build-prisma.mjs). Data is synthetic and per-instance.
# Migrations: npx prisma migrate deploy
DATABASE_URL=postgresql://user:pass@host:5432/nexura

# JWT signing secret for sessions/tokens. Self-hosted production requires
# >= 16 chars; src/lib/auth/jwt.ts throws rather than falling back to an
# insecure default. Generate: openssl rand -hex 32
# On a zero-config serverless demo (VERCEL=1, nothing configured) an
# EPHEMERAL per-boot secret is minted instead: sessions reset on every
# cold start until you set a real one.
JWT_SECRET=change-me-at-least-16-chars

# Redis — rate limiting (nx:rl:*), the SSE event-bus fan-out
# (nx:bus), background-sync leases (nx:lock:*), and the
# distributed limiter fronting withRoute use it.
# REQUIRED on self-hosted (VM/container) production boots.
# OPTIONAL on serverless/PaaS (Vercel auto-detected via VERCEL=1,
# or force with NEXURA_REDIS_OPTIONAL=1): layers degrade to
# documented single-instance fallbacks. Set it (e.g. Upstash)
# to restore cross-instance rate limiting and event delivery.
REDIS_URL=redis://127.0.0.1:6379

# ---------- RECOMMENDED ----------

# Demo affordances (demo quick-login surfaces, synthetic ABDM
# lookup, demo OTP code). Secure default is OFF. Never enable
# outside a sandbox/demo deployment.
DEMO_MODE=false

# Outbound email transport: "console" (prints to server log —
# the demo delivery channel) or "smtp" (real mail via nodemailer).
EMAIL_TRANSPORT=console

# SMTP settings — required when EMAIL_TRANSPORT=smtp.
# Example (Gmail): SMTP_HOST=smtp.gmail.com SMTP_PORT=587
# SMTP_USER/SMTP_PASS = account/app-password, SMTP_FROM = "Nexura OS <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site URL used for absolute links in emails/webhooks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- OPTIONAL ----------

# AI: OpenRouter key. When absent, src/lib/openrouter.ts falls
# back to the z-ai SDK path (documented provider order).
OPENROUTER_API_KEY=

# Nexura integration posture: "local" adapters (default) or
# "remote" (requires NEXURA_API_URL).
NEXURA_MODE=local
NEXURA_API_URL=

# Telemetry label override for the AI model version reported
# by the gateway (defaults to the real provider path via
# activeModelId()).
NX_AI_MODEL_VERSION=

# Shared secret for verifying INBOUND webhooks (HMAC).
NX_INBOUND_WEBHOOK_SECRET=

# Read-replica routing: plumbed but routes to the primary until
# replica wiring lands (documented in PRODUCTION_STATUS.md).
DB_READ_URL=

# Prisma connection pool size (default: Prisma default).
DB_POOL_SIZE=

# Background job worker: set "0" to disable the in-process
# runner on web/API runtimes (see DEPLOYMENT.md runtime split).
NEXURA_JOBS=

# Session idle timeout in minutes (default: see src/lib/nx/session.ts).
NX_SESSION_IDLE_MIN=

# Audit/log retention window in days.
NEXURA_RETENTION_DAYS=

# DICOM viewer template route for imaging deep-links.
DICOM_VIEWER_TEMPLATE=

# ---------- VERCEL-DEPLOY-3 BUILD/BOOT SELECTORS (advanced) ----------

# Force the Prisma client flavor generated by scripts/build-prisma.mjs:
# "postgres" | "sqlite" (default: auto — sqlite when VERCEL=1/NEXURA_DEMO_DB=1
# and no DATABASE_URL, else postgres).
NEXURA_PRISMA_CLIENT=

# Force the zero-config demo-DB bootstrap on a non-Vercel runtime
# (same effect as VERCEL=1 for src/lib/demo-db.ts).
NEXURA_DEMO_DB=

# Explicit path of the bundled demo database (probed at db/demo.db,
# ../db/demo.db, ../../db/demo.db when unset).
NEXURA_DEMO_DB_PATH=

# ---------- OBSERVABILITY (10x run 1) ----------

# Optional bearer gate for GET /api/metrics (JSON snapshot + Prometheus text
# via ?format=prometheus). When set, callers must present it as
# "Authorization: Bearer <token>" or "?token=<token>". Leave empty on
# trusted/single-node deployments where the probe class of /api/ready is
# already network-protected.
METRICS_TOKEN=
